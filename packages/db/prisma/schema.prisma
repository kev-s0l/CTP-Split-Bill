// Receipt-owned bill splitting. Participants are receipt-local contacts, not
// accounts; calculated bills are immutable snapshots with manual paid tracking.

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  output     = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?  @unique
  createdAt DateTime @default(now()) @map("created_at")

  receipts Receipt[]

  @@map("users")
}

enum ReceiptStatus {
  DRAFT
  FINALIZED
}

enum ParseStatus {
  NOT_STARTED
  PARSING
  SUCCEEDED
  FAILED
}

enum SplitMode {
  EVEN
  ITEMIZED
  SHARED_ITEMS
}

model Receipt {
  id      String @id @default(cuid())
  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  title        String?
  merchantName String?   @map("merchant_name")
  address      String?
  purchasedAt  DateTime? @map("purchased_at")
  currency     String   @default("USD") @db.Char(3)

  status      ReceiptStatus @default(DRAFT)
  parseStatus ParseStatus   @default(NOT_STARTED) @map("parse_status")
  splitMode   SplitMode     @default(EVEN) @map("split_mode")

  imageBlobName    String @map("image_blob_name")
  imageContentType String @map("image_content_type")
  extraction      Json?
  parseError      String? @map("parse_error")

  subtotal Decimal? @db.Decimal(12, 2)
  tax      Decimal? @db.Decimal(12, 2)
  tip      Decimal? @db.Decimal(12, 2)
  total    Decimal? @db.Decimal(12, 2)

  revision    Int       @default(1)
  reviewedAt  DateTime? @map("reviewed_at")
  finalizedAt DateTime? @map("finalized_at")

  paidByParticipantId String?      @map("paid_by_participant_id")
  paidByParticipant   Participant? @relation("ReceiptPayer", fields: [id, paidByParticipantId], references: [receiptId, id], onDelete: Restrict, onUpdate: NoAction)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  participants Participant[] @relation("ReceiptParticipants")
  items        ReceiptItem[]
  bills        Bill[]

  @@index([ownerId, deletedAt, createdAt, id])
  @@map("receipts")
}

model Participant {
  id          String   @id @default(cuid())
  receiptId   String   @map("receipt_id")
  receipt     Receipt  @relation("ReceiptParticipants", fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  displayName String   @map("display_name")
  phone       String?
  joinedAt    DateTime @default(now()) @map("joined_at")

  assignedItems     ReceiptItem[]         @relation("ItemAssignee")
  sharedAllocations SharedItemAllocation[]
  bills             Bill[]
  paidReceipts      Receipt[]             @relation("ReceiptPayer")

  @@unique([receiptId, id])
  @@index([receiptId, joinedAt, id])
  @@map("participants")
}

model ReceiptItem {
  id         String   @id @default(cuid())
  receiptId  String   @map("receipt_id")
  receipt    Receipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lineNumber Int      @map("line_number")
  name       String?
  quantity   Decimal? @db.Decimal(10, 3)
  unitPrice  Decimal? @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal? @map("total_price") @db.Decimal(12, 2)
  isVerified Boolean  @default(false) @map("is_verified")

  assignedParticipantId String?      @map("assigned_participant_id")
  assignedParticipant   Participant? @relation("ItemAssignee", fields: [receiptId, assignedParticipantId], references: [receiptId, id], onDelete: Restrict, onUpdate: NoAction)
  sharedAllocations     SharedItemAllocation[]

  @@unique([receiptId, lineNumber])
  @@unique([receiptId, id])
  @@index([receiptId, assignedParticipantId])
  @@map("receipt_items")
}

model SharedItemAllocation {
  receiptId     String      @map("receipt_id")
  itemId        String      @map("item_id")
  participantId String      @map("participant_id")
  item          ReceiptItem @relation(fields: [receiptId, itemId], references: [receiptId, id], onDelete: Restrict, onUpdate: NoAction)
  participant   Participant @relation(fields: [receiptId, participantId], references: [receiptId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([itemId, participantId])
  @@index([receiptId])
  @@index([participantId])
  @@map("shared_item_allocations")
}

// Only finalization writes these amounts. Payment status never changes them.
model Bill {
  id            String      @id @default(cuid())
  receiptId     String      @map("receipt_id")
  receipt       Receipt     @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  participantId String      @map("participant_id")
  participant   Participant @relation(fields: [receiptId, participantId], references: [receiptId, id], onDelete: Restrict, onUpdate: NoAction)
  subtotal      Decimal     @db.Decimal(12, 2)
  taxShare      Decimal     @map("tax_share") @db.Decimal(12, 2)
  tipShare      Decimal     @map("tip_share") @db.Decimal(12, 2)
  amountOwed    Decimal     @map("amount_owed") @db.Decimal(12, 2)
  paidAt        DateTime?   @map("paid_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")

  @@unique([receiptId, participantId])
  @@index([participantId])
  @@map("bills")
}
